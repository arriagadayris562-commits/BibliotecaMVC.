@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"] <small class="text-muted">(@Model.Count())</small></h1>

    @* Permitir ver el botón de crear al Administrador o al Bibliotecario *@
    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
    {
        <a class="btn btn-primary" asp-action="Create">Nuevo Libro +</a>
    }
</div>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card mb-4 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@libro.Titulo</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@libro.Autor</h6>
                    <p class="card-text mb-1">Categoría: <strong>@libro.Categoria</strong></p>
                    <p class="card-text mb-1">Precio: <strong>$@libro.Precio.ToString("F2")</strong></p>
                    <p class="card-text mb-3">
                        Estado:
                        @if (libro.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Agotado</span>
                        }
                    </p>

                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <div>
                            <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@libro.ID">Detalles</a>

                            @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                            {
                                <a class="btn btn-outline-secondary swal-edit-link" asp-action="Edit" asp-route-id="@libro.ID">Editar</a>
                            }
                        </div>

                        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                        {
                            <form asp-action="Delete" asp-route-id="@libro.ID" method="post" class="swal-delete-form d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">Eliminar</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>