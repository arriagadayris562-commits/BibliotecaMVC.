@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
}

<div class="card shadow-sm col-md-8 mx-auto mt-4">
    <div class="card-body">
        <h2 class="card-title text-primary">@Model.Titulo</h2>
        <h6 class="card-subtitle mb-3 text-muted">Autor: @Model.Autor</h6>

        <dl class="row">
            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Model.Categoria</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">$@Model.Precio</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Disponible)
                {
                    <span class="badge bg-success">Disponible</span>
                }
                else
                {
                    <span class="badge bg-danger">Agotado</span>
                }
            </dd>
        </dl>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.ID">Editar</a>
            <form asp-action="Delete" asp-route-id="@Model.ID" method="post" class="swal-delete-form d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Eliminar</button>
            </form>
            <a asp-action="Index" class="btn btn-primary ms-auto">Volver al listado</a>
        </div>
    </div>
</div>