<!-- Título principal anterior -->
<div class="text-center my-4">
    <h1 class="display-5">Sistema de Gestión de Biblioteca</h1>
    <p class="lead">Bienvenido al sistema desarrollado con ASP.Net Core MVC.</p>
</div>

<!-- flexbox alinear y ordenar las tarjetas de las secciones -->
<div class="d-flex flex-wrap justify-content-center align-items-stretch gap-4 mt-4">

    <!-- Tarjeta de Libros -->
    <div class="col-md-3 mb-3" style="min-width: 250px;">
        <div class="p-3 border bg-light h-100">
            <h3>Libros</h3>
            <p>Consulta el catálogo de libros disponibles.</p>
            <a class="btn btn-primary btn-sm" asp-controller="Libros" asp-action="Index">Ir a Libros</a>
        </div>
    </div>

    <!-- Tarjeta de Autores -->
    <div class="col-md-3 mb-3" style="min-width: 250px;">
        <div class="p-3 border bg-light h-100">
            <h3>Autores</h3>
            <p>Revisa la lista de autores registrados.</p>
            <a class="btn btn-success btn-sm" asp-controller="Autores" asp-action="Index">Ir a Autores</a>
        </div>
    </div>

    <!-- Tarjeta de Categorías -->
    <div class="col-md-3 mb-3" style="min-width: 250px;">
        <div class="p-3 border bg-light h-100">
            <h3>Categorías</h3>
            <p>Filtra por géneros y temáticas literarias.</p>
            <a class="btn btn-info btn-sm text-white" asp-controller="Home" asp-action="Categorias">Ver Categorías</a>
        </div>
    </div>

    <!-- Tarjeta de Servicios -->
    <div class="col-md-3 mb-3" style="min-width: 250px;">
        <div class="p-3 border bg-light h-100">
            <h3>Servicios</h3>
            <p>Gestiona los préstamos y consultas.</p>
            <a class="btn btn-warning btn-sm" asp-controller="Home" asp-action="Prestamos">Ver Servicios</a>
        </div>
    </div>
</div>

